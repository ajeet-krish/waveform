# Copy to .env for local development. docker compose (infra/docker-compose.yml)
# provides Postgres with these defaults.

# Postgres connection string (local compose credentials)
DATABASE_URL=postgres://waveform:waveform@localhost:5432/waveform

# HTTP bind address; Render injects its own PORT in production
HOST=0.0.0.0
PORT=8080

# Server-side key for bearer sessions: session tokens are stored only as
# an HMAC-SHA256 keyed by this value, so rotating it invalidates every
# active session. Generate with `openssl rand -hex 32`; minimum 32
# characters. Required to serve (never needed for `migrate`).
SESSION_SECRET=replace-with-openssl-rand-hex-32-output

# Browser origin allowed to call the API (CORS, exact match). Defaults to
# the local Vite dev server; the GitHub Pages deployment is
# https://ajeet-krish.github.io.
ALLOWED_WEB_ORIGIN=http://localhost:5173

# Apply pending migrations during API startup. Defaults to false so
# production never runs DDL on boot; deploys apply migrations explicitly
# with `cargo run -p waveform-api -- migrate`. The value below opts local
# development into startup migration for convenience.
RUN_MIGRATIONS=true

# Structured logging filter (tracing EnvFilter syntax)
RUST_LOG=waveform_api=info,sqlx=warn

# Frontend build only (apps/web, Vite): base URL the web app will call the
# API on once the sync client lands. Local development points at the API
# above; the deployed GitHub Pages site points at the Render service.
# VITE_API_BASE_URL=http://localhost:8080

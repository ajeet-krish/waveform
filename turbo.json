{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "migrations/0002_seed_catalog.sql",
    "migrations/0004_catalog_cleanup.sql"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
